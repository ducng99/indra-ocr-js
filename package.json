{
  "name": "@ducng99/indra-ocr-js",
  "version": "0.1.0",
  "description": "indra-ocr ONNX models in JavaScript — browser (onnxruntime-web, wasm) and Node (onnxruntime-node): line detection, recognition (Latin + CJK), reading order, orientation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./browser": "./src/browser.mjs"
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/browser.mjs",
    "test:node": "node test/node.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "puppeteer": "^25.14.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducng99/indra-ocr-js.git"
  },
  "keywords": [
    "ocr",
    "onnx",
    "indra-ocr"
  ],
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "puppeteer@25.14.0": true,
    "protobufjs@7.6.6": true
  }
}
